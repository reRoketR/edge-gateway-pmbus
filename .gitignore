# =============================================================================
# .gitignore — PMBus-MQTT Edge Gateway (monorepo root)
# =============================================================================

# ModusToolbox shared libraries (restored by `make getlibs` in each project)
mtb_shared/

# Eclipse / ModusToolbox workspace metadata
.metadata/

# ModusToolbox build outputs & caches (both projects)
*/build/
*/Debug/
*/Release/
*/*_build/
*/libs/
*/.mtbqueryapi
*/.ninja_log
*/library-manager.log
*/project_info.json
*/GeneratedSource/
*.lock

# ModusToolbox auto-generated / IDE files
*/.metadata/
*/.settings/
*/.cproject
*/.project
*/.mtbLaunchConfigs/
*/.mtb-prefs.json
*/makefile.init

# BSPs: target_proj uses default BSP (regenerated by getlibs)
# rtos_test BSP is custom → tracked via rtos_test/.gitignore override
target_proj/bsps/

# VS Code / IDE
.vscode/
*.code-workspace
*/.vscode/
*/openocd.tcl

# clangd LSP cache
*/.cache/
*/.clangd

# Secrets — local Wi-Fi credentials
rtos_test/configs/wifi_config_local.h

# Original MTB template README
rtos_test/README_original.md

