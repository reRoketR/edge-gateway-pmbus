# =============================================================================
# .gitignore — PMBus Target Simulator (target_proj)
# =============================================================================

# ModusToolbox library repos (restored by `make getlibs`)
libs/

# ModusToolbox BSP (auto-generated, not customised)
bsps/

# ModusToolbox build output & caches
build/
Debug/
Release/
*_build/
GeneratedSource/
*.lock
.mtbqueryapi
.ninja_log
library-manager.log
project_info.json
.mtb-prefs.json

# Eclipse / ModusToolbox IDE
.metadata/
.settings/
.cproject
.project
.mtbLaunchConfigs/
makefile.init

# VS Code / IDE
.vscode/
*.code-workspace
openocd.tcl

# clangd LSP cache
.cache/
.clangd

# Uncomment this if not using project connections
# *.ipcf

# Comment this out if using custom argument variables
*.custom_argvars

# IAR Debugger Settings
# *.ewd

# Comment this out if you use C-Stat or C-Run to compile/analyze your project
*.ewt

# IAR Workspace files
# *.eww

# IAR Debug Exe
/Debug/Exe/

# IAR Debug List
/Debug/List

# IAR Debug Obj
/Obj/*.pbd
/Obj/*.pbd.*
/Obj/*.pbi
/Obj/*.pbi.*

# Log files
*.log

# IAR backup files
Backup*

# IAR dependency files
*.dep

# Compiled Binaries
*.bin
*.elf
*.hex
*.map

# Trash files
*.bak


# Keil uVision files

# Project and package description files
*.cpdsc
*.gpdsc

# uVision Project file (generated by uVision). Uncomment this if you do not want to track the Keil uVision project file
# *.uvprojx (is used to build the project from scratch)

# Project options file (contains information about the debugger and trace configuration)
# *.uvoptx

# Project file for multi-project workspaces
# *.uvmpw

# Project screen layout file
*.uvguix.*

# Configuration files for the run-time environment
# RTE/

# Generated output files
*.lst
*.map

# Vi and Emacs backup files
*~
\#*\#
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

# macOS Finder incidental files
.DS_Store

# Windows Explorer incidental files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
